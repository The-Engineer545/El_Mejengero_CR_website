# Copia este archivo como .env y llena los valores reales.
# Nunca subas el .env a GitHub.
DB_HOST=
DB_PORT=4000
DB_USER=
DB_PASSWORD=
DB_NAME=mejenguero
# Orígenes del frontend permitidos por CORS, separados por coma.
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# Login del administrador. Genera los valores con: node scripts/generar-secretos.js
ADMIN_USER=
ADMIN_PASSWORD_HASH=
JWT_SECRET=
